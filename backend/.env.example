# Backend environment - copier vers `.env` et compléter. Ne jamais committer `.env`.

APP_NAME="Miara API"
API_VERSION=v1

# Origines navigateur autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:3010

# Infra native Ubuntu (voir scripts/setup_ubuntu.sh).
# Runtime = rôle miara_app (soumis au RLS) ; migrations = miara_admin (BYPASSRLS).
DATABASE_URL=postgresql+asyncpg://miara_app:CHANGE_ME@localhost:5432/miara
DATABASE_URL_ADMIN=postgresql+asyncpg://miara_admin:CHANGE_ME@localhost:5432/miara
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# Clé Fernet (credentials d'intégration, ADR-005). Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# Connected App Salesforce (ADR-005). Callback URL de la Connected App =
# SF_REDIRECT_URI. SF_LOGIN_URL : test.salesforce.com pour un bac à sable.
SF_CLIENT_ID=CHANGE_ME
SF_CLIENT_SECRET=CHANGE_ME
SF_LOGIN_URL=https://test.salesforce.com
SF_REDIRECT_URI=http://localhost:3010/api/v1/integrations/salesforce/callback

# Budget de jetons du contexte structuré injecté à l'agent commercial (ADR-008).
# --- Presélection RH (ADR-007) ---------------------------------------
# Racine du stockage des CV (relatif = ancré sur backend/). Hors dépôt :
# ce sont des données personnelles.
HR_STORAGE_DIR=storage
HR_MAX_UPLOAD_FILES=20
HR_MAX_FILE_MB=10
HR_LLM_CALLS_PER_MINUTE=60
HR_SCREENING_CONCURRENCY=8
HR_CALIBRATE_TOP_K=0

SALES_CONTEXT_BUDGET_TOKENS=3000

# Secret HS256 des JWT d'accès (carte auth). Générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Clés fournisseurs LLM (optionnelles tant qu'aucun agent ne tourne).
# Les modèles/alias se configurent dans config/llm.yaml, jamais dans le code.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
