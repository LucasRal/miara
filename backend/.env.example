# Backend environment - copier vers `.env` et compléter. Ne jamais committer `.env`.

APP_NAME="Miara API"
API_VERSION=v1

# Origines navigateur autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:3010

# Infra native Ubuntu (voir scripts/setup_ubuntu.sh).
# Runtime = rôle miara_app (soumis au RLS) ; migrations = miara_admin (BYPASSRLS).
DATABASE_URL=postgresql+asyncpg://miara_app:CHANGE_ME@localhost:5432/miara
DATABASE_URL_ADMIN=postgresql+asyncpg://miara_admin:CHANGE_ME@localhost:5432/miara
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/0

# Clé Fernet (credentials d'intégration, ADR-005). Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# Secret HS256 des JWT d'accès (carte auth). Générer : openssl rand -hex 32
JWT_SECRET=CHANGE_ME
