%% Boucle bornee du runtime d'agent. Source : app/core/agents/runtime.py, run().
flowchart TB
    depart(["run(definition, input, ctx)"])
    prompt["load_prompt : prompts/agent/vN.md<br/>prompt_version retenue"]
