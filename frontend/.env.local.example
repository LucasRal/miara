# Frontend environment — copy to `.env.local` (git-ignored) and fill in.
# Only NEXT_PUBLIC_* vars are exposed to the browser; never put secrets here.

# Backend origin the BROWSER calls. Left empty: /api/* is proxied same-origin
# to the backend via next.config.ts rewrites (required for remote/VPS access).
NEXT_PUBLIC_API_URL=

# Backend origin the NEXT SERVER proxies to (server-side only). Fixed port 8010.
BACKEND_URL=http://localhost:8010
