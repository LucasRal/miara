# ---------------------------------------------------------------------------
# Miara - environnement de PRODUCTION.
#
# Fichier cible : /etc/miara/.env   (root:miara, chmod 640)
# Chargé par : les units systemd (EnvironmentFile=) et scripts/deploy.sh.
#
# 640 et non 600 (la carte disait 600) : systemd lirait un 600 root:root sans
# problème, mais deploy.sh tourne sous l'utilisateur `miara` et doit lire les
# mêmes valeurs (alembic a besoin de DATABASE_URL_ADMIN, `next build` des
# NEXT_PUBLIC_*). Le groupe `miara` n'a qu'un seul membre : le service.
#
# Ce fichier-ci est un EXEMPLE à valeurs factices, committé dans le dépôt.
# Le vrai fichier ne vit QUE sur le VPS, hors du dépôt : aucun secret ici.
#
# Remarque : le backend lit ces valeurs via pydantic-settings, qui prend
# l'environnement du processus en priorité. En production il n'y a donc
# AUCUN backend/.env : tout passe par /etc/miara/.env.
# ---------------------------------------------------------------------------

# --- Domaine public --------------------------------------------------------
# Nom DNS servi par nginx ; sert aussi à générer le certificat TLS.
MIARA_DOMAIN=miara.example.org

# --- Application -----------------------------------------------------------
APP_NAME="Miara API"
API_VERSION=v1
# CORS : en production le navigateur ne parle qu'à nginx, en https, sur le
# domaine public. Tout le reste doit être refusé.
ALLOWED_ORIGINS=https://miara.example.org
# Cookies de session en Secure : obligatoire dès qu'on est derrière TLS.
COOKIE_SECURE=true

# --- Base de données -------------------------------------------------------
# Runtime = rôle miara_app, SOUMIS aux politiques RLS (ADR-002). C'est la
# seule URL que l'API et les workers doivent utiliser.
DATABASE_URL=postgresql+asyncpg://miara_app:CHANGE_ME_APP@127.0.0.1:5432/miara
# Migrations UNIQUEMENT (alembic, BYPASSRLS). Jamais au runtime.
DATABASE_URL_ADMIN=postgresql+asyncpg://miara_admin:CHANGE_ME_ADMIN@127.0.0.1:5432/miara

# --- Broker / cache --------------------------------------------------------
# RabbitMQ et Redis n'écoutent que sur la loopback (cf. scripts/setup_vps.sh) :
# le pare-feu n'ouvre ni 5672 ni 6379.
RABBITMQ_URL=amqp://miara:CHANGE_ME_RABBIT@127.0.0.1:5672/miara
REDIS_URL=redis://127.0.0.1:6379/0

# --- Secrets applicatifs ---------------------------------------------------
# Fernet, chiffre les credentials d'intégration (ADR-005). Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET
# HS256 des JWT d'accès (ADR-003). Générer : openssl rand -hex 32
# (JWT_ALGORITHM reste HS256, fixé par l'ADR : rien à surcharger ici.)
JWT_SECRET=CHANGE_ME_JWT
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Salesforce (ADR-005) --------------------------------------------------
# SF_REDIRECT_URI doit correspondre EXACTEMENT à la Callback URL de la
# Connected App, donc au domaine public en https (pas localhost:3010).
SF_CLIENT_ID=CHANGE_ME
SF_CLIENT_SECRET=CHANGE_ME
SF_LOGIN_URL=https://login.salesforce.com
SF_REDIRECT_URI=https://miara.example.org/api/v1/integrations/salesforce/callback

# --- Présélection RH (ADR-007) ---------------------------------------------
# CV déposés = données personnelles : hors dépôt, sur un chemin dédié dont
# seul l'utilisateur miara a les droits (créé par setup_vps.sh en 0700).
HR_STORAGE_DIR=/var/lib/miara/storage
HR_MAX_UPLOAD_FILES=20
HR_MAX_FILE_MB=10
HR_LLM_CALLS_PER_MINUTE=60
HR_SCREENING_CONCURRENCY=8
HR_CALIBRATE_TOP_K=0

# --- Tableau de bord -------------------------------------------------------
# Temps de tri manuel d'un CV, référence du gain affiché : c'est une HYPOTHÈSE
# de l'organisation, pas une mesure, elle doit pouvoir se régler sans toucher
# au code. Durée du cache Redis de l'agrégat en secondes.
DASHBOARD_MINUTES_PER_CV=6
DASHBOARD_CACHE_SECONDS=60

# --- Agent commercial (ADR-008) --------------------------------------------
SALES_CONTEXT_BUDGET_TOKENS=3000

# --- Limitation des tentatives de connexion (ADR-003) ----------------------
# 5 essais par fenêtre de 15 minutes, par couple (email, IP).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Fournisseurs LLM (ADR-004 / ADR-011) ----------------------------------
# Aucun nom de modèle ici : les alias vivent dans backend/config/llm.yaml.
LLM_CONFIG_PATH=
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=

# --- Dimensionnement des services systemd ----------------------------------
# API : 2 à 4 workers uvicorn (carte INFRA). Règle d'usage : ~1 par vCPU,
# borné à 4 tant que la base tourne sur la même machine.
API_WORKERS=3
# Files Celery (ADR-006) : heavy = scoring/extraction LLM, light = CRM.
WORKER_HEAVY_CONCURRENCY=4
WORKER_LIGHT_CONCURRENCY=2

# --- Frontend (Next.js) ----------------------------------------------------
NODE_ENV=production
# Origine que le SERVEUR Next appelle pour proxifier /api/* (jamais le
# navigateur). Port backend fixe 8010.
BACKEND_URL=http://127.0.0.1:8010
# Vide : le navigateur appelle /api/* en same-origin, via nginx.
# Attention : les NEXT_PUBLIC_* sont figées au BUILD, pas au démarrage.
NEXT_PUBLIC_API_URL=
