# ---------------------------------------------------------------------------
# Réglages de la sauvegarde quotidienne - FACULTATIF.
# Fichier cible : /etc/miara/backup.env (root:root, 0644 — aucun secret ici).
#
# Sans ce fichier, scripts/backup_db.sh utilise ses valeurs par défaut, qui
# conviennent à l'installation standard. Il n'y a volontairement PAS de mot de
# passe : le dump est pris par l'utilisateur système `postgres` en
# authentification peer.
# ---------------------------------------------------------------------------

# Base à sauvegarder.
DB_NAME=miara

# Répertoire des dumps (créé en 0700 root:root par setup_vps.sh).
BACKUP_DIR=/var/backups/miara

# Rétention en jours (carte INFRA : 14).
RETENTION_DAYS=14

# Taille minimale attendue d'un dump, en octets. En dessous, le script rejette
# la sauvegarde : c'est le symptôme d'une base vide ou d'un dump interrompu.
MIN_SIZE_BYTES=20480
